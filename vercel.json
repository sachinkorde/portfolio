{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    { "source": "/play/block-puzzle", "destination": "https://play.google.com/store/apps/details?id=studio.gamefusion.blockpuzzle&referrer=utm_source%3Dsachinkorde.online%26utm_medium%3Dshortlink%26utm_campaign%3Dblock-puzzle", "permanent": false },
    { "source": "/play/sweet-swirl-saga", "destination": "https://play.google.com/store/apps/details?id=studio.gamefusionstudio.sweetswirlsaga&referrer=utm_source%3Dsachinkorde.online%26utm_medium%3Dshortlink%26utm_campaign%3Dsweet-swirl-saga", "permanent": false },
    { "source": "/play/screw-puzzle", "destination": "https://play.google.com/store/apps/details?id=studio.gamefusion.screwpuzzle&referrer=utm_source%3Dsachinkorde.online%26utm_medium%3Dshortlink%26utm_campaign%3Dscrew-puzzle", "permanent": false },
    { "source": "/play", "destination": "/games/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/js/games/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/assets/(projects|blog)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(.*)\\.(svg|png|webp|jpg|jpeg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/assets/(.*)\\.pdf",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
